# Tailscale auth key for the VPS sidecar. Copy this file to .tailscale.env and fill the key.
# .tailscale.env is gitignored. Do not put TS_AUTHKEY in .env.
# Create a reusable key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Optional. Send the VPS's public internet out through the phone. Tailnet addresses (100.x),
# including ADB to the phone, still go directly over the tailnet.
# TS_EXTRA_ARGS=--exit-node=100.110.143.89
