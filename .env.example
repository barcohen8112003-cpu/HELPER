# ---- המודל (חובה) ----
# כל ספק עם API תואם OpenAI עובד. דוגמאות ל-LLM_BASE_URL:
#   OpenAI:      https://api.openai.com/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:  https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# שם המודל כפי שהספק קורא לו (חייב לתמוך ב-tool calling)
LLM_MODEL=

# ---- כללי ----
BOT_NAME=Helper
# שעת סיכום בוקר יומי (HH:MM), ריק = כבוי
DAILY_BRIEF_TIME=08:00

# ---- חיפוש (לא חובה) ----
# בלי מפתח משתמשים ב-DuckDuckGo. עם מפתח Tavily התוצאות טובות יותר.
TAVILY_API_KEY=

# ---- מייל (לא חובה) ----
# IMAP. ב-Gmail: imap.gmail.com + "סיסמת אפליקציה" (לא הסיסמה הרגילה).
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
MAIL_POLL_MINUTES=10

# ---- יומן (לא חובה, קריאה בלבד) ----
# Google Calendar > הגדרות היומן > "כתובת סודית בפורמט iCal"
CALENDAR_ICS_URL=

# ---- שליטה במחשב ----
# off = כבוי | ask = מבקש אישור בוואטסאפ לפני כל פקודה/כתיבה | auto = מריץ בלי לשאול (מסוכן)
# בענן: ask (או auto) יחד עם PC_BRIDGE_SECRET. בלי הסוד הכלים נשארים כבויים על שרת לינוקס.
COMPUTER_MODE=ask

# ---- גשר למחשב הביתי (רק כשהעוזר רץ בענן) ----
# סוד משותף עם home-relay/pc-bridge.mjs. מחרוזת אקראית ארוכה. ריק = אין גשר.
PC_BRIDGE_SECRET=
# הפורט שהענן מאזין עליו. המחשב הביתי מתחבר אליו החוצה. ב-Render לא נוגעים: השירות מאזין על PORT.
# ההאזנה נדלקת רק עם PC_BRIDGE_LISTEN=1 (docker-compose עושה את זה). אל תדליק את זה על המחשב הביתי.
PC_BRIDGE_PORT=3212
# רק על המחשב הביתי, לא בענן: כתובת הגשר. Oracle: ws://IP:3212/pc  Render: wss://השם.onrender.com/pc
PC_BRIDGE_URL=
# רק על המחשב הביתי: הסיסמה ש"תבטל נעילה" מקליד. נשארת במחשב, לא עוברת דרך המודל או הענן. ריק = רק מעלה את מסך ההתחברות.
PC_UNLOCK_PASSWORD=

# כמה הודעות לא דחופות מותר לו לשלוח מיוזמתו ביום. מה שמעבר לזה נכנס לסיכום הבא. ריק = 6.
MESSAGE_BUDGET=

# ---- גיבוי יומי מוצפן ל-Google Drive ----
# הסיסמה שמצפינה את הגיבוי. בלעדיה אי אפשר לשחזר, אז שמור אותה גם מחוץ ל-Helper. ריק = אין גיבוי.
BACKUP_PASSPHRASE=
# לאיזה חשבון Google. ריק = הראשון שלא מסומן "קריאה בלבד". שחזור: node scripts/restore-backup.mjs <קובץ> <תיקייה>
BACKUP_GOOGLE_ACCOUNT=

# ---- הודעות קוליות (לא חובה) ----
# שם מודל התמלול אצל אותו ספק (נקודת הקצה /audio/transcriptions). ריק = כבוי.
STT_MODEL=

# ---- תיבות מייל נוספות (לא חובה, עד MAIL5) ----
MAIL2_HOST=
MAIL2_USER=
MAIL2_PASS=

# ---- Google: Gmail, יומן, Tasks, Drive (לא חובה) ----
# יוצרים OAuth client מסוג Desktop ב-Google Cloud (הוראות ב-README), ואז מריצים npm run google לכל חשבון.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- שיחות טלפון (לא חובה) ----
# מזהה הסוכן הקולי מ-ElevenLabs. VOICE_SECRET נוצר אוטומטית בהפעלה הראשונה.
ELEVENLABS_AGENT_ID=
VOICE_SECRET=

# ---- Webtop (לא חובה, קריאה בלבד) ----
# כתובת האתר שאתה נכנס אליו.
# בבית: מפעילים webtop-browser.bat ונכנסים שם פעם אחת. החלון נשאר פתוח, והעוזר מרענן אותו כל כמה דקות.
# בענן: WEBTOP_CLOUD=1 מריץ Chromium משלו בקונטיינר (פרופיל ב-data/webtop-profile), גם כשהמחשב בבית כבוי.
# נכנסים פעם אחת מדף Webtop באתר ההגדרות (/webtop), מהטלפון או מהמחשב. הסיסמה לא נשמרת אצל העוזר.
# בלי WEBTOP_CLOUD הקריאה עוברת בגשר לחלון שבבית, כמו קודם.
# שרת מחוץ לישראל (למשל Contabo בצרפת) נחסם ב-CloudFront של Webtop: 403 Request blocked, גם ב-curl.
# בלי פרוקסי הקריאה עוברת אוטומטית לחלון שבבית, והאתר מציג «וובטופ חוסם את כתובת השרת, משתמשים במחשב הביתי».
# על החסימה הזו לא נשלחת הודעת וואטסאפ. כדי ש-Webtop בענן כן יעבוד משרת כזה: פרוקסי ישראלי, http או socks5.
# הדגל ניתן רק ל-Chromium של Webtop, לא ל-Google Home.
# WEBTOP_PROXY=http://user:pass@proxy.example:8080
# WEBTOP_PROXY=socks5://proxy.example:1080
WEBTOP_URL=
WEBTOP_CLOUD=
WEBTOP_PROXY=
WEBTOP_KEEPALIVE_MINUTES=10

# ---- Google Home בענן (לא חובה) ----
# 1: Chromium נפרד בקונטיינר, פרופיל ב-data/google-home-profile, פורט דיבוג 9226 על 127.0.0.1 בלבד.
# נכנסים פעם אחת מדף /google-home באתר ההגדרות (אפשר לבחור שם גם Webtop).
# Google לפעמים חוסם התחברות בדפדפן headless. החלון הזה עולה על מסך וירטואלי (xvfb) כדי שאפשר יהיה להיכנס ידנית.
# אם Google עדיין חוסם, משאירים את חלון Google Home במחשב הביתי והגשר מחובר: השליטה עוברת אליו.
# בלי הדגל, שרת בענן שולח את הפעולה למחשב הביתי דרך הגשר.
GOOGLE_HOME_CLOUD=
GOOGLE_HOME_DEBUG_PORT=9226
GOOGLE_HOME_KEEPALIVE_MINUTES=10

# ---- שולחן עבודה בענן (לא חובה) ----
# 1: מסך X אחד (:99, 1280x800), fluxbox, x11vnc על localhost, ו-noVNC על פורט 6080 בתוך הקונטיינר.
# 6080 לא נפתח לאינטרנט ואין להוסיף אותו ל-ports. Webtop ו-Google Home עולים על המסך הזה כחלון אמיתי
# (לא headless), עם אותם פרופילים ב-/var/data, אז התחברות מהשולחן נשמרת לקריאה ולשליטה של העוזר.
# WEBTOP_PROXY עדיין ניתן רק ל-Chromium של Webtop.
# נכנסים מאתר ההגדרות: «שולחן עבודה בענן» (/desktop/), אחרי עוגיית ההתחברות.
# או מהטלפון שב-tailnet: https://helper-vps.tail526bd3.ts.net/vnc.html?autoconnect=1&resize=scale&reconnect=1&show_dot=1
# סיסמת VNC אופציונלית. גם איתה, הקישור באתר ההגדרות דורש את העוגייה.
CLOUD_DESKTOP=
CLOUD_DESKTOP_VNC_PASSWORD=

# ---- טלפון Android ב-ADB דרך Tailscale (לא חובה) ----
# כתובת ה-Tailscale של הטלפון (100.x), לא כתובת ה-Wi-Fi. הפורט משתנה ונקבע בצימוד, לא כאן.
# PHONE_MODE: ask (ברירת מחדל) קריאה בלי אישור, כל שינוי מבקש "כן" בוואטסאפ.
# ask-writes זהה ל-ask. ask-all מבקש אישור גם על צילום. auto בלי אישור, חוץ מפקודת shell מסוכנת. off מכבה.
# PHONE_PROXY: socks5 אל ה-sidecar. ריק: אם WEBTOP_PROXY הוא socks5 הוא בשימוש, אחרת socks5://tailscale:1055.
# direct: בלי פרוקסי, רק אם התהליך הזה כבר מגיע לטלפון. מפתח Tailscale לא נכתב כאן: הוא ב-.tailscale.env.
PHONE_ADB_HOST=
PHONE_MODE=ask
PHONE_PROXY=

# ---- אתר ההגדרות כשהוא חשוף לכתובת ציבורית (לא חובה) ----
# כשהעוזר רץ בשרת ופותחים את אתר ההגדרות מהטלפון, למשל http://37.60.240.231:3210
# בלי זה האתר מקבל רק 127.0.0.1 ו-localhost.
# התחברות Google דרך הכתובת הציבורית הזו לא עובדת: Google דורש https או לולאה מקומית של Desktop.
# הדרך: בבית מריצים npm run google, ומעלים את data/google.json לשרת.
UI_PUBLIC_HOST=
# כתובת שהאפליקציה מחייגת אליה (קוד ה-QR). ריק: http://UI_PUBLIC_HOST כשהוא מוגדר, ואחרת כתובת הרשת המקומית.
# בשרת כדאי להשאיר ריק כש-UI_PUBLIC_HOST כבר כולל את הפורט. מלאה רק אם הכתובת שונה, למשל http://37.60.240.231:3210
APP_PUBLIC_URL=

# ---- דפדפן הסוכן לסידורים (run_errand) ----
# בענן: חלון Chromium שלישי על שולחן העבודה (:99), פרופיל /var/data/errand-profile, פורט דיבוג 9227 על
# 127.0.0.1 בלבד. לא לפרסם את 9227. חתימה על חנויות: דף «דפדפן קניות» (/errand) ואז שולחן העבודה.
# ERRAND_PROXY: פרוקסי לחנויות ישראליות (זאפ, KSP). ריק = אותו ערך כמו WEBTOP_PROXY. direct = בלי פרוקסי.
# עם פרוקסי של Tailscale התעבורה יוצאת דרך הטלפון (exit node), כדי שהחנות תראה כתובת ישראלית ומחיר בשקלים.
# בבית, בלי WEBTOP_CLOUD: חלון Chrome/Edge נפרד כמקודם. לפני תשלום או הזמנה העוזר שואל בוואטסאפ עם צילום מסך.
ERRAND_DEBUG_PORT=9227
ERRAND_PROXY=

# ---- Gemini (לא חובה) ----
# כדי שאפשר יהיה לכתוב לעוזר "תשאל את ג'מיני ...". מפתח חינמי: aistudio.google.com/apikey
GEMINI_API_KEY=
# המודל של Gemini לשאלות
GEMINI_MODEL=gemini-2.5-flash

# ---- מטלות Classroom דרך Gemini (לא חובה) ----
# כשנכנסת מטלה חדשה, העוזר אוסף אותה עם הקבצים, שולח ל-Gemini בדפדפן שלו ומחזיר לך קובץ בוואטסאפ.
# הוא לא מגיש כלום ב-Classroom. אחרי שממלאים GEMINI_URL, מפעילים gemini-browser.bat ונכנסים שם פעם אחת
# לחשבון Google הפרטי. החלון נשאר פתוח. ריק = היכולת כבויה.
GEMINI_URL=
# פורט הדיבוג של החלון (Webtop משתמש ב-9223)
GEMINI_DEBUG_PORT=9224
# auto = מתחיל לבד כשנכנסת מטלה, ask = שואל אותך קודם בוואטסאפ, off = רק כשאתה מבקש
CLASSROOM_AUTOWORK=auto
# תקרת הגודל של כל הקבצים במטלה אחת, במגה-בייט
CLASSROOM_MAX_MB=50
# כמה זמן לחכות לתשובה של Gemini, בדקות
GEMINI_TIMEOUT_MINUTES=15

# ---- GitHub (לא חובה, קריאה בלבד) ----
# Personal access token מסוג fine-grained עם הרשאות קריאה בלבד
GITHUB_TOKEN=

# ---- שעות שקט (לא חובה) ----
# בשעות האלה נשלחות רק תזכורות והתראות אבטחה; כל השאר מחכה לסוף השעות. ריק = כבוי.
QUIET_HOURS=22:00-08:00

# ---- תשובה בקול (לא חובה) ----
# כשמוגדר, הודעה קולית ממך מקבלת תשובה קולית. שם מודל ההקראה (נקודת הקצה /audio/speech) ושם הקול.
TTS_MODEL=
TTS_VOICE=alloy
# אם ספק הצ'אט שלך לא מציע תמלול והקראה, אפשר להפנות את הקול לספק אחר. ריק = אותו ספק ואותו מפתח.
VOICE_BASE_URL=
VOICE_API_KEY=

# ---- ElevenLabs: הודעות קוליות (לא חובה) ----
# כשיש מפתח, ElevenLabs מטפל גם בהבנת הודעות קוליות וגם בתשובה בקול, וההגדרות STT/TTS שלמעלה לא בשימוש.
ELEVENLABS_API_KEY=
# מזהה הקול שבו העוזר מדבר (מרשימת הקולות בחשבון שלך)
ELEVENLABS_VOICE_ID=
# המודל חייב לתמוך בעברית: eleven_v3 או eleven_v4
ELEVENLABS_TTS_MODEL=eleven_v3

# ---- יצירת תמונות (לא חובה) ----
# תמונות וסרטונים דרך ElevenLabs דורשים שם חבילת Pro ומעלה. לחלופין: שם של מודל תמונות אצל ספק הצ'אט (נקודת הקצה /images/generations).
IMAGE_MODEL=

# ---- חשבונות לקריאה בלבד ----
# מחשבונות Google האלה העוזר רק קורא: הוא לא שולח מהם מייל ולא מוסיף בהם אירועים או משימות. מופרדים בפסיק.
GOOGLE_READONLY_ACCOUNTS=

# ---- מודלים נוספים אצל אותו ספק (לא חובה) ----
# זול: לעבודת רקע תכופה (סינון מיילים, בדיקת מעקבים, סיכומים). ריק = המודל הראשי.
LLM_CHEAP_MODEL=
# חזק: לרגעים חשובים, מפעילים בצ'אט עם /model strong וחוזרים עם /model default.
LLM_STRONG_MODEL=
# גיבוי: מנסים אותו אם המודל הראשי נופל.
LLM_FALLBACK_MODEL=

# ---- אזור זמן ----
# כל התזכורות, השעות והתאריכים לפי האזור הזה, גם אם שעון המחשב מוגדר אחרת.
TIMEZONE=Asia/Jerusalem

# ---- מצב קל ----
# לספקים עם מכסת טוקנים קטנה לדקה (חבילות חינמיות). משתמש ב-persona.short.md, מקצר את השיחה ואת תוצאות הכלים.
LLM_LIGHT=false

# ---- סיכום שבועי ללימודים ----
# שבת בשעה הזאת (HH:MM) נשלח מה מחכה בשבוע הקרוב: מבחנים, הגשות ויומן. ריק = 20:00, off = כבוי.
WEEKLY_REVIEW_TIME=

# ---- תקציר חדשות בוקר ----
# שעה (HH:MM) שבה נשלח תקציר של מה שקרה מאז אתמול בערב. ריק = כבוי. צריכה להיות מחוץ לשעות השקט.
NEWS_BRIEF_TIME=08:00
# מקורות (RSS) בעברית, מופרדים בפסיק. ריק = ynet, מעריב וישראל היום.
NEWS_FEEDS=

# --- Quiet monitoring (מעקב שקט) ---
# כל ברירת מחדל עובדת גם בלי לגעת בכלום.
WATCH_STATE_PATH=./data/watch-state.json
WATCH_MAX_TOOL_ROUNDS=4
WATCH_MAX_TOKENS=2000
WATCH_CHECK_TIMEOUT_MS=30000
WATCH_SEEN_IDS_CAP=500
# מודל זול לבדיקת טריגר, ומודל חזק להחלטת הדחיפות בלבד. placeholder או ריק = המודלים של העוזר.
WATCH_MODEL_FILTER=<cheap-model-id>
WATCH_MODEL_URGENCY=<strong-model-id>
# פריט שנצבר ויש לו מועד אחרון קרוב מזה (בשעות) נשלח מיד
URGENT_DEADLINE_HOURS=12
# לשלוח בריף בוקר גם כשאין בו כלום
DAILY_BRIEF_ALWAYS=false
# הגברה או השתקה: <שם>=interrupt-all|batch-all|drop-all, אפשר @YYYY-MM-DD לתאריך סיום, כמה ערכים מופרדים בפסיק
# WATCH_OVERRIDE_SOURCE=mail/<account>=interrupt-all@2026-12-01
# WATCH_OVERRIDE_TOPIC=<topic>=interrupt-all
WATCH_OVERRIDE_SOURCE=
WATCH_OVERRIDE_TOPIC=

# קיימים, ומשפיעים על המעקב השקט:
# QUIET_HOURS=22:00-08:00   בחלון הזה נשלח רק מה שהוחלט עליו interrupt
# DAILY_BRIEF_TIME          אם הוא בתוך שעות השקט, הבריף יוצא בסופן: max(DAILY_BRIEF_TIME, סוף QUIET_HOURS)
# MAIL_POLL_MINUTES=10      מרווח הסקר של תיבות IMAP כשהחיבור החי נפל
# TIMEZONE=Asia/Jerusalem   כל חישוב זמן

# ---- יוזמה עצמית ----
# כמה פעמים ביום העוזר פונה אליך בעצמו, בלי שהתחלת שיחה (0 = אף פעם), ומה המרווח המינימלי בדקות.
# לא בשעות השקט. אם אין לו משהו אמיתי לומר, הוא מדלג.
CHECK_IN_PER_DAY=0
CHECK_IN_EVERY_MINUTES=180

# ---- האזנה חיה למייל של Google ----
# true = מייל חדש מדווח ברגע שהוא נכנס (חיבור IMAP חי, לקריאה בלבד). false = בדיקה כל שתי דקות.
LIVE_MAIL=true

# ---- ספק גיבוי (לא חובה) ----
# נכנס לפעולה רק כשהמכסה של כל המודלים של הספק הראשי נגמרת. כל ספק תואם OpenAI.
# Gemini (מפתח חינמי מ-aistudio.google.com): https://generativelanguage.googleapis.com/v1beta/openai
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=

# ---- המחשב של העוזר (מכונת לינוקס ב-VirtualBox) ----
# פעיל כשקיים מפתח ב-data/vm/id_ed25519. העוזר מריץ שם פקודות בלי אישור; אין לה גישה לקבצים שלך.
VM_NAME=helper-box
VM_SSH_PORT=2222
VM_USER=helper

# ---- הדלקת המחשב מרחוק (Wake-on-LAN) ----
# כתובת הכרטיס של המחשב (MAC). עם /wake בוואטסאפ או "תדליק את המחשב" העוזר שולח חבילת הדלקה.
WAKE_MAC=
# כתובת השידור של הרשת הביתית, בדרך כלל x.x.x.255
WAKE_BROADCAST=
# רק כשהעוזר רץ מחוץ לבית (ענן): נושא וסוד שמזווגים אותו עם home-relay/wake-relay.mjs שרץ על מכשיר שתמיד דלוק בבית
WAKE_RELAY_TOPIC=
WAKE_SECRET=

# ---- כלים שתמיד מחכים ל"כן" שלך ----
# כלים ברשימה לא רצים לפני שאישרת בצ'אט, גם אם אף אחד לא ביקש אישור בתוך הכלי עצמו. מופרדים בפסיק. ריק = אין.
CONFIRM_ALWAYS=pc_type,pc_press_key,pc_unlock,pc_clipboard_get,pc_clipboard_set
