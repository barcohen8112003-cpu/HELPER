# ---- המודל (חובה) ----
# כל ספק עם API תואם OpenAI עובד. דוגמאות ל-LLM_BASE_URL:
#   OpenAI:      https://api.openai.com/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:  https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# שם המודל כפי שהספק קורא לו (חייב לתמוך ב-tool calling)
LLM_MODEL=

# ---- כללי ----
BOT_NAME=Helper
# שעת סיכום בוקר יומי (HH:MM), ריק = כבוי
DAILY_BRIEF_TIME=08:00

# ---- קבוצות וואטסאפ (לא חובה) ----
# on = קורא את הקבוצות (כיתה, שכבה, חוגים) ומוציא רק מה שחשוב: בבוקר, ב"מה פספסתי?", והודעה מיד על מבחן/ביטול/שינוי למחר.
# אפשר גם להדליק ולכבות מהצ'אט ("תתחיל לעקוב אחרי הקבוצות"). נשמר רק בשרת, ב-data/groups.json, לא בגיבוי.
WHATSAPP_GROUPS=off
# on = מוסיף ליומן ולמשימות לבד מה שחשוב מאוד, בלי לשאול. ברירת המחדל שואלת כל פעם.
GROUPS_AUTO_ADD=off
# כמה שעות נשמרות ההודעות עצמן (ברירת מחדל 48), וכל כמה דקות עוברים עליהן (ברירת מחדל 10)
GROUPS_KEEP_HOURS=48
GROUPS_EVERY_MINUTES=10
# שיעורי בית ומטלות מכל מקורות בית הספר יחד (src/schoolwork.js): Classroom, Webtop והקבוצות שבחרת.
# כבוי עד אישור. on = התראה על מטלה חדשה כשהמקור נקרא, וסיכום יומי של מה שפתוח, כולל מה שלא נבדק.
# שומר רק אצלך (data/schoolwork.json, לא בגיבוי): כותרת, קורס או קבוצה, מועד, סטטוס. לא שומר הודעות או שולחים.
SCHOOLWORK=off
# שעת הסיכום היומי ואזור הזמן (off = בלי סיכום יומי)
SCHOOLWORK_DAILY_TIME=15:00
SCHOOLWORK_TZ=Asia/Jerusalem
# שמות (או חלקי שמות) של קבוצות בית הספר, מופרדים בפסיק. ריק = לא קורא שיעורי בית מקבוצות. דורש WHATSAPP_GROUPS=on.
SCHOOLWORK_GROUPS=
# אחרי כל דיפלוי (sha חדש) נשלחת הודעת וואטסאפ אחת עם סיכום קצר. off = בלי הודעה. אותו sha אחרי ריסטארט לא שולח שוב.
UPDATE_NOTES=on

# ---- Bird: וואטסאפ עסקי (לא חובה, כבוי) ----
# שליחה ממספר עסקי, בנוסף לוואטסאפ האישי. לא מחליף אותו: השיחה האישית נשארת על Baileys.
# מפתח לבד לא מפעיל כלום. צריך BIRD_ENABLED=true.
BIRD_ENABLED=false
BIRD_API_KEY=
BIRD_WHATSAPP_FROM=
BIRD_OWNER_NUMBER=
BIRD_WEBHOOK_SECRET=

# Instinct: עוזר AI אחר שמדברים איתו בוואטסאפ. עם המספר שלו Helper יכול לשאול אותו בשבילך ולהחזיר את התשובה.
# ריק = כבוי. למשל: INSTINCT_NUMBER=+16508702892
INSTINCT_NUMBER=
# מצב שיחה: כמה הודעות לכל היותר Helper שולח לבד בשיחה אחת (ברירת מחדל 40, וגם עד שעתיים). "עצור" מסיים קודם.
INSTINCT_CHAT_MAX_TURNS=40
# "תלמד מ-Instinct": Helper מראיין אותו, והלקחים נשמרים ונכנסים לשימוש מיד (צריך SELF_LEARNING=on).
# off = כל לקח מחכה לאישור. לקח עם קישור, הרצה או עקיפת אישור מחכה תמיד. קוד Helper לא משנה לבד.
INSTINCT_LEARN_AUTO=on

# ---- חיפוש (לא חובה) ----
# בלי מפתח משתמשים ב-DuckDuckGo. עם מפתח Tavily התוצאות טובות יותר.
TAVILY_API_KEY=
# Jina Reader: lookup_read_page works without a key; a free key raises the rate limit (https://jina.ai/reader/)
JINA_API_KEY=
# Price comparison through Google Shopping (src/shopping.js): searchapi.io key, or SERPAPI_KEY
SEARCHAPI_KEY=
# טיסות אמיתיות: Travelpayouts (חינם) לתאריכים הזולים בטווח, Duffel להצעות חיות עם שעות וקונקשן
TRAVELPAYOUTS_TOKEN=
DUFFEL_TOKEN=
# לינה: מלונות ודירות נופש עם מחירים, דרך SerpApi Google Hotels (250 חיפושים בחודש בחינם, serpapi.com)
SERPAPI_KEY=
# מטבע המחירים בלינה (ברירת מחדל ILS)
STAYS_CURRENCY=
# יוטיוב: חיפוש דרך YouTube Data API v3 (חינם). ריק = קריאת דף התוצאות כמו קודם
YOUTUBE_API_KEY=

# ---- צוות (לא חובה, כבוי) ----
# ריק או off: המסלול הרגיל בדיוק. live: רק כש-TEAM_MODEL ושני המחירים ושתי התקרות מלאים. שדה חסר = הכל כבוי.
# טיסה עם מגבלות: חוקר ובודק. בקשה גדולה (יום בעיר עם תקציב, תוכנית לימוד) או המילה "צוות": חדר מלחמה.
# תקרות הטיסה לא עולות מעל 4 קריאות, 12000/4000 טוקנים ו-90 שניות. חדר המלחמה חולק את אותן תקרות דולר.
# ראה src/team/README.md
TEAM_MODE=
TEAM_MODEL=
TEAM_PRICE_IN_PER_MTOK=
TEAM_PRICE_OUT_PER_MTOK=
TEAM_MAX_USD_PER_REQUEST=
TEAM_MAX_USD_PER_DAY=
# חדר מלחמה. אפשר רק להוריד. לא מדליק כלום בלי TEAM_MODE=live (או mock בבדיקות).
# TEAM_MAX_AGENTS=4          # 2 עד 4. מתכנן ומבקר תמיד, ואז קונה אם יש כסף, ואז חוקר
# TEAM_MAX_ROUNDS=2          # 1 או 2. הסבב השני הוא ויכוח בין המתכנן למבקר
# TEAM_WAR_MAX_CALLS=8       # 2 עד 8 קריאות מודל לבקשה
# TEAM_WAR_MAX_IN_TOKENS=16000   # 2000 עד 20000
# TEAM_WAR_MAX_OUT_TOKENS=4000   # 256 עד 6000
# TEAM_WAR_DEADLINE_SECONDS=     # ריק = כמו TEAM_DEADLINE_SECONDS (עד 90). מלא: 10 עד 120
# TEAM_WAR_UPDATES=2         # 0 עד 3 הודעות וואטסאפ קצרות באמצע, ואז תשובה אחת
# TEAM_MAX_MODEL_CALLS=4     # רק פרופיל הטיסה. 1 עד 4
# TEAM_MAX_IN_TOKENS=12000
# TEAM_MAX_OUT_TOKENS=4000
# TEAM_DEADLINE_SECONDS=90

# ---- קריאת דפים עם Scrapling (לא חובה, כבוי) ----
# true: fetch_page קורא דפים ציבוריים ב-https דרך Scrapling (Python), עם בדיקת כתובות פרטיות, הפניות ו-robots.txt.
# צריך venv מותקן, ראה py/README.md. בדוקר: INSTALL_SCRAPLING=true בבנייה. ריק או false: הקורא הרגיל.
SCRAPLING_ENABLED=
# SCRAPLING_PYTHON=           # ברירת מחדל: .venv-scrapling/bin/python (בדוקר /opt/scrapling-venv/bin/python)
# SCRAPLING_TIMEOUT_MS=30000  SCRAPLING_MAX_BYTES=2097152  SCRAPLING_MAX_CHARS=30000  SCRAPLING_CONCURRENCY=2
# SCRAPLING_EGRESS_PROXY=     # רק פרוקסי יציאה מבוקר. ריק בשרת רגיל

# ---- מייל (לא חובה) ----
# IMAP. ב-Gmail: imap.gmail.com + "סיסמת אפליקציה" (לא הסיסמה הרגילה).
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
MAIL_POLL_MINUTES=10

# ---- יומן (לא חובה, קריאה בלבד) ----
# Google Calendar > הגדרות היומן > "כתובת סודית בפורמט iCal"
CALENDAR_ICS_URL=

# ---- שליטה במחשב ----
# off = כבוי | ask = מבקש אישור בוואטסאפ לפני כל פקודה/כתיבה | auto = מריץ בלי לשאול (מסוכן)
# בענן: ask (או auto) יחד עם PC_BRIDGE_SECRET. בלי הסוד הכלים נשארים כבויים על שרת לינוקס.
COMPUTER_MODE=ask

# ---- גשר למחשב הביתי (רק כשהעוזר רץ בענן) ----
# סוד משותף עם home-relay/pc-bridge.mjs. מחרוזת אקראית ארוכה. ריק = אין גשר.
PC_BRIDGE_SECRET=
# הפורט שהענן מאזין עליו. המחשב הביתי מתחבר אליו החוצה. ב-Render לא נוגעים: השירות מאזין על PORT.
# ההאזנה נדלקת רק עם PC_BRIDGE_LISTEN=1 (docker-compose עושה את זה). אל תדליק את זה על המחשב הביתי.
PC_BRIDGE_PORT=3212

# ---- פנים מדברות (כבוי כברירת מחדל) ----
# off: כלום לא משתנה. on: כשהעוזר מדבר, דף /face (טלוויזיה, טלפון, אתר ההגדרות) מציג פנים.
# המחשב הביתי (RTX) מרנדר דרך LiveTalking אם השירות שם רץ. אם המחשב כבוי או שהמודל חסר, הדפדפן מצייר לבד.
# אין פורט חדש על השרת. האימות הוא עוגיית אתר ההגדרות, קוד הגשר, או כרטיס קצר שנגזר מ-PC_BRIDGE_SECRET.
# FACE_ENGINE: auto (מחשב אם מחובר, אחרת דפדפן) | pc | browser
# FACE_TV: auto (לפתוח את הדף בטלוויזיה רק בסיכום הבוקר) | on | off. צריך UI_PUBLIC_HOST.
# FACE_WEBRTC: off (ברירת מחדל, התמונות חוזרות בגשר) | on (גם ניסיון WebRTC ישיר ברשת הביתית).
# FACE_LIP_DELAY_MS: כמה לחכות לפני השמע כשהמחשב מרנדר, כדי שהפה ידביק את הקול. ברירת מחדל 350.
# FACE_LOCAL_URL: רק על המחשב הביתי. חייב להיות http://127.0.0.1:8771 (או localhost). כתובת אחרת מתעלמים ממנה.
FACE_ENABLED=off
FACE_ENGINE=auto
FACE_TV=auto
FACE_WEBRTC=off
# FACE_LIP_DELAY_MS=350
# FACE_LOCAL_URL=http://127.0.0.1:8771
# רק על המחשב הביתי, לא בענן: כתובת הגשר. Oracle: ws://IP:3212/pc  Render: wss://השם.onrender.com/pc
PC_BRIDGE_URL=
# רק על המחשב הביתי: הסיסמה ש"תבטל נעילה" מקליד. נשארת במחשב, לא עוברת דרך המודל או הענן. ריק = רק מעלה את מסך ההתחברות.
PC_UNLOCK_PASSWORD=

# כמה הודעות לא דחופות מותר לו לשלוח מיוזמתו ביום. מה שמעבר לזה נכנס לסיכום הבא. ריק = 6.
MESSAGE_BUDGET=

# ---- Claude Code ----
# "תבקש מ-Claude לבנות לי אתר": משימות בנייה על חשבון מנוי Claude, בלי מפתח API.
# במחשב כלשהו: npm i -g @anthropic-ai/claude-code ואז claude setup-token. את הטוקן מדביקים כאן (או באתר ההגדרות).
CLAUDE_CODE_OAUTH_TOKEN=

# ---- לוגים ----
# json = שורת JSON אחת לכל רשומה (לכלי ניטור). ריק = טקסט רגיל. מפתחות וסיסמאות מוסתרים בכל מקרה.
LOG_FORMAT=

# ---- עלויות ----
# מחירי מודלים בדולר למיליון טוקנים, "מודל=קלט/פלט" מופרדים בפסיק. מודל שלא מופיע נחשב חינמי.
# לדוגמה: gpt-4.1-mini=0.4/1.6,gpt-4.1=2/8
LLM_PRICES=
# תקרה חודשית בדולר. התראה ב-80% וב-100%. ריק = בלי תקרה. סיכום של החודש הקודם נשלח ב-1 לחודש בכל מקרה.
MONTHLY_COST_LIMIT=

# ---- גיבוי יומי מוצפן ל-Google Drive ----
# הסיסמה שמצפינה את הגיבוי. בלעדיה אי אפשר לשחזר, אז שמור אותה גם מחוץ ל-Helper. ריק = אין גיבוי.
BACKUP_PASSPHRASE=
# לאיזה חשבון Google. ריק = הראשון שלא מסומן "קריאה בלבד". שחזור: node scripts/restore-backup.mjs <קובץ> <תיקייה>
BACKUP_GOOGLE_ACCOUNT=

# ---- הודעות קוליות (לא חובה) ----
# שם מודל התמלול אצל אותו ספק (נקודת הקצה /audio/transcriptions). ריק = כבוי.
STT_MODEL=

# ---- תיבות מייל נוספות (לא חובה, עד MAIL5) ----
MAIL2_HOST=
MAIL2_USER=
MAIL2_PASS=

# ---- Google: Gmail, יומן, Tasks, Drive (לא חובה) ----
# יוצרים OAuth client מסוג Desktop ב-Google Cloud (הוראות ב-README), ואז מריצים npm run google לכל חשבון.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- שיחות טלפון (לא חובה) ----
# מזהה הסוכן הקולי מ-ElevenLabs. VOICE_SECRET נוצר אוטומטית בהפעלה הראשונה.
ELEVENLABS_AGENT_ID=
VOICE_SECRET=

# ---- Webtop (לא חובה, קריאה בלבד) ----
# כתובת האתר שאתה נכנס אליו.
# בבית: מפעילים webtop-browser.bat ונכנסים שם פעם אחת. החלון נשאר פתוח, והעוזר מרענן אותו כל כמה דקות.
# בענן: WEBTOP_CLOUD=1 מריץ Chromium משלו בקונטיינר (פרופיל ב-data/webtop-profile), גם כשהמחשב בבית כבוי.
# נכנסים פעם אחת מדף Webtop באתר ההגדרות (/webtop), מהטלפון או מהמחשב. הסיסמה לא נשמרת אצל העוזר.
# בלי WEBTOP_CLOUD הקריאה עוברת בגשר לחלון שבבית, כמו קודם.
# שרת מחוץ לישראל (למשל Contabo בצרפת) נחסם ב-CloudFront של Webtop: 403 Request blocked, גם ב-curl.
# בלי פרוקסי הקריאה עוברת אוטומטית לחלון שבבית, והאתר מציג «וובטופ חוסם את כתובת השרת, משתמשים במחשב הביתי».
# על החסימה הזו לא נשלחת הודעת וואטסאפ. כדי ש-Webtop בענן כן יעבוד משרת כזה: פרוקסי ישראלי, http או socks5.
# הדגל ניתן רק ל-Chromium של Webtop, לא ל-Google Home.
# WEBTOP_PROXY=http://user:pass@proxy.example:8080
# WEBTOP_PROXY=socks5://proxy.example:1080
WEBTOP_URL=
WEBTOP_CLOUD=
WEBTOP_PROXY=
WEBTOP_KEEPALIVE_MINUTES=10
# התראות בוואטסאפ על ציון חדש, שינוי במערכת, מבחן חדש ואירוע או הודעה של בית הספר (להיום ולמחר).
# נקרא מה-API של Webtop עצמו דרך אותו חלון מחובר. בפעם הראשונה רק זוכר מה יש, ואחר כך מודיע רק על חדש.
# false מכבה. WEBTOP_ALERTS_MINUTES: כל כמה דקות לבדוק (מינימום 15).
WEBTOP_ALERTS=true
WEBTOP_ALERTS_MINUTES=60
# WEBTOP_HOMEWORK_PATH: הדף ב-Webtop שמבקש את לוח שיעורי הבית (dashboard/GetHomeWork). נקרא רק כש-SCHOOLWORK פעיל,
# באותה קריאה שעתית, מהבקשה של הדף עצמו. לא אומת על חשבון אמיתי: אם הדף לא מבקש את הלוח, זה מופיע כפער.
WEBTOP_HOMEWORK_PATH=/dashboard

# ---- Google Home בענן (לא חובה) ----
# 1: Chromium נפרד בקונטיינר, פרופיל ב-data/google-home-profile, פורט דיבוג 9226 על 127.0.0.1 בלבד.
# נכנסים פעם אחת מדף /google-home באתר ההגדרות (אפשר לבחור שם גם Webtop).
# Google לפעמים חוסם התחברות בדפדפן headless. החלון הזה עולה על מסך וירטואלי (xvfb) כדי שאפשר יהיה להיכנס ידנית.
# אם Google עדיין חוסם, משאירים את חלון Google Home במחשב הביתי והגשר מחובר: השליטה עוברת אליו.
# בלי הדגל, שרת בענן שולח את הפעולה למחשב הביתי דרך הגשר.
GOOGLE_HOME_CLOUD=
GOOGLE_HOME_DEBUG_PORT=9226
GOOGLE_HOME_KEEPALIVE_MINUTES=10

# ---- שולחן עבודה בענן (לא חובה) ----
# 1: מסך X אחד (:99, 1280x800), fluxbox, x11vnc על localhost, ו-noVNC על פורט 6080 בתוך הקונטיינר.
# 6080 לא נפתח לאינטרנט ואין להוסיף אותו ל-ports. Webtop ו-Google Home עולים על המסך הזה כחלון אמיתי
# (לא headless), עם אותם פרופילים ב-/var/data, אז התחברות מהשולחן נשמרת לקריאה ולשליטה של העוזר.
# WEBTOP_PROXY עדיין ניתן רק ל-Chromium של Webtop.
# נכנסים מאתר ההגדרות: «שולחן עבודה בענן» (/desktop/), אחרי עוגיית ההתחברות.
# או מהטלפון שב-tailnet: https://helper-vps.tail526bd3.ts.net/vnc.html?autoconnect=1&resize=scale&reconnect=1&show_dot=1
# סיסמת VNC אופציונלית. גם איתה, הקישור באתר ההגדרות דורש את העוגייה.
CLOUD_DESKTOP=
CLOUD_DESKTOP_VNC_PASSWORD=

# ---- טלפון Android ב-ADB דרך Tailscale (לא חובה) ----
# כתובת ה-Tailscale של הטלפון (100.x), לא כתובת ה-Wi-Fi. הפורט משתנה ונקבע בצימוד, לא כאן.
# PHONE_MODE: ask (ברירת מחדל) קריאה בלי אישור, כל שינוי מבקש "כן" בוואטסאפ.
# ask-writes זהה ל-ask. ask-all מבקש אישור גם על צילום. auto בלי אישור, חוץ מפקודת shell מסוכנת. off מכבה.
# PHONE_PROXY: socks5 אל ה-sidecar. ריק: אם WEBTOP_PROXY הוא socks5 הוא בשימוש, אחרת socks5://tailscale:1055.
# direct: בלי פרוקסי, רק אם התהליך הזה כבר מגיע לטלפון. מפתח Tailscale לא נכתב כאן: הוא ב-.tailscale.env.
PHONE_ADB_HOST=
PHONE_MODE=ask
PHONE_PROXY=

# סוכן שרואה את המסך (לולאה כמו DroidRun: צילום + עץ נגישות ← מודל ראייה ← לחיצה/הקלדה/גלילה ← בדיקה).
# כבוי כברירת מחדל. on (או true): run_on_phone מצלם כל צעד בתמונה מוקטנת ומתכנן במודל ראייה זול.
# בלי הדגל, run_on_phone נשאר על עץ הנגישות כמו קודם, בלי צילום בכל צעד.
# לפני שליחה, תשלום, שיחה, מחיקה, שינוי הגדרות או הרשאות, ולפני אפליקציית בנק או תשלום, הוא עוצר לאישור בוואטסאפ.
# סיסמה לא מוקלדת. "עצור" עוצר מיד. עובד מוואטסאפ (טקסט או הודעה קולית) ומשיחה קולית באפליקציה.
# PHONE_VISION_MODEL: מודל ראייה זול אצל אותו ספק. ריק = google/gemini-2.5-flash.
# PHONE_VISION_WIDTH: רוחב הצילום שנשלח למודל, 240 עד 720. ברירת מחדל 480.
# PHONE_AGENT_MAX_STEPS: ריק = 16 כשהסוכן דלוק, 40 כשהוא כבוי. תקרה 40.
# PHONE_AGENT_TIMEOUT_SEC: כמה שניות מותר לריצה. ריק = 180 כשהסוכן דלוק, 480 כשהוא כבוי. תקרה 600.
PHONE_VISION_AGENT=off
PHONE_VISION_MODEL=
PHONE_VISION_WIDTH=480
PHONE_AGENT_MAX_STEPS=
PHONE_AGENT_TIMEOUT_SEC=

# ---- אתר ההגדרות כשהוא חשוף לכתובת ציבורית (לא חובה) ----
# כשהעוזר רץ בשרת ופותחים את אתר ההגדרות מהטלפון, למשל http://37.60.240.231:3210
# בלי זה האתר מקבל רק 127.0.0.1 ו-localhost.
# התחברות Google דרך הכתובת הציבורית הזו לא עובדת: Google דורש https או לולאה מקומית של Desktop.
# הדרך: בבית מריצים npm run google, ומעלים את data/google.json לשרת.
UI_PUBLIC_HOST=
# כתובת שהאפליקציה מחייגת אליה (קוד ה-QR). ריק: http://UI_PUBLIC_HOST כשהוא מוגדר, ואחרת כתובת הרשת המקומית.
# בשרת כדאי להשאיר ריק כש-UI_PUBLIC_HOST כבר כולל את הפורט. מלאה רק אם הכתובת שונה, למשל http://37.60.240.231:3210
APP_PUBLIC_URL=

# ---- דפדפן הסוכן לסידורים (run_errand) ----
# בענן: חלון Chromium שלישי על שולחן העבודה (:99), פרופיל /var/data/errand-profile, פורט דיבוג 9227 על
# 127.0.0.1 בלבד. לא לפרסם את 9227. חתימה על חנויות: דף «דפדפן קניות» (/errand) ואז שולחן העבודה.
# ERRAND_PROXY: פרוקסי לחנויות ישראליות (זאפ, KSP). ריק = אותו ערך כמו WEBTOP_PROXY. direct = בלי פרוקסי.
# עם פרוקסי של Tailscale התעבורה יוצאת דרך הטלפון (exit node), כדי שהחנות תראה כתובת ישראלית ומחיר בשקלים.
# בבית, בלי WEBTOP_CLOUD: חלון Chrome/Edge נפרד כמקודם. לפני תשלום או הזמנה העוזר שואל בוואטסאפ עם צילום מסך.
ERRAND_DEBUG_PORT=9227
ERRAND_PROXY=

# ---- דפדפן אנונימי (Obscura) לחיפוש, קריאת דפים וסקר מחירים ----
# רץ לצד Chromium, לא במקומו. Webtop / Google Home / Gemini / חלון הקניות והשולחן לא משתנים.
# דלוק כברירת מחדל. off / 0 / false / no מכבה. אם התהליך חסר, נפל, נתקע או שהאתר חסם, נשארת הדרך הקודמת.
# הפורט תמיד על 127.0.0.1 בתוך הקונטיינר. לא לפרסם אותו. 9223/9224/9226/9227 שמורים ל-Chromium; בקשה אליהם מתעלמת.
# OBSCURA_PROXY: יציאה משלו. ריק = ERRAND_PROXY, ואם גם הוא ריק אז WEBTOP_PROXY. direct = בלי פרוקסי.
# OBSCURA_V8_HEAP_MB=192  OBSCURA_MAX_RSS_MB=400  OBSCURA_TIMEOUT_MS=20000  OBSCURA_BIN=/usr/local/bin/obscura
OBSCURA_ENABLED=on
OBSCURA_PORT=9228
OBSCURA_PROXY=

# ---- לימוד עצמי (כבוי כברירת מחדל) ----
# on = לקחים, כלים שהעוזר כותב לעצמו ולימוד לילי. צריך Claude Code או Gemini (למטה). הכל כבוי בלי זה.
SELF_LEARNING=off

# ---- מצב סוכן ----
# מטרה של כמה שלבים מקבלת תוכנית (מטרה, שלבים, מתי זה גמור), ביצוע עם הכלים, ובדיקה מול "גמור" לפני התשובה.
# AGENT_SHOW_PLAN=on = לשלוח את התוכנית בצ'אט כשהיא נוצרת (כבוי כברירת מחדל: כל תשובה היא הודעה אחת).
# AGENT_MAX_STEPS = כמה צעדים מותר לתור עם תוכנית (ריק = 24, ובמצב חסכוני 10). שאלה רגילה נשארת עם המגבלה הקצרה.
AGENT_SHOW_PLAN=
AGENT_MAX_STEPS=

# ---- Gemini (לא חובה) ----
# כדי שאפשר יהיה לכתוב לעוזר "תשאל את ג'מיני ...". מפתח חינמי: aistudio.google.com/apikey
GEMINI_API_KEY=
# המודל של Gemini לשאלות
GEMINI_MODEL=gemini-2.5-flash

# ---- מטלות Classroom דרך Gemini (לא חובה) ----
# כשנכנסת מטלה חדשה, העוזר אוסף אותה עם הקבצים, שולח ל-Gemini בדפדפן שלו ומחזיר לך קובץ בוואטסאפ.
# הוא לא מגיש כלום ב-Classroom. אחרי שממלאים GEMINI_URL, מפעילים gemini-browser.bat ונכנסים שם פעם אחת
# לחשבון Google הפרטי. החלון נשאר פתוח. ריק = היכולת כבויה.
GEMINI_URL=
# פורט הדיבוג של החלון (Webtop משתמש ב-9223)
GEMINI_DEBUG_PORT=9224
# auto = מתחיל לבד כשנכנסת מטלה, ask = שואל אותך קודם בוואטסאפ, off = רק כשאתה מבקש
CLASSROOM_AUTOWORK=auto
# תקרת הגודל של כל הקבצים במטלה אחת, במגה-בייט
CLASSROOM_MAX_MB=50
# כמה זמן לחכות לתשובה של Gemini, בדקות
GEMINI_TIMEOUT_MINUTES=15

# ---- GitHub (לא חובה, קריאה בלבד) ----
# Personal access token מסוג fine-grained עם הרשאות קריאה בלבד
GITHUB_TOKEN=

# ---- שעות שקט (לא חובה) ----
# בשעות האלה נשלחות רק תזכורות והתראות אבטחה; כל השאר מחכה לסוף השעות. ריק = כבוי.
QUIET_HOURS=22:00-08:00

# ---- תשובה בקול (לא חובה) ----
# כשמוגדר, הודעה קולית ממך מקבלת תשובה קולית. שם מודל ההקראה (נקודת הקצה /audio/speech) ושם הקול.
TTS_MODEL=
TTS_VOICE=alloy
# אם ספק הצ'אט שלך לא מציע תמלול והקראה, אפשר להפנות את הקול לספק אחר. ריק = אותו ספק ואותו מפתח.
VOICE_BASE_URL=
VOICE_API_KEY=

# ---- ElevenLabs: הודעות קוליות (לא חובה) ----
# כשיש מפתח, ElevenLabs מטפל גם בהבנת הודעות קוליות וגם בתשובה בקול, וההגדרות STT/TTS שלמעלה לא בשימוש.
ELEVENLABS_API_KEY=
# מזהה הקול שבו העוזר מדבר (מרשימת הקולות בחשבון שלך)
ELEVENLABS_VOICE_ID=
# המודל חייב לתמוך בעברית: eleven_v3 או eleven_v4
ELEVENLABS_TTS_MODEL=eleven_v3

# ---- שיחה חיה (כבוי כברירת מחדל, בלי GPU) ----
# on = כפתור באפליקציה, דף /live באתר ההגדרות, ו"תתקשר אליי" בוואטסאפ. בלי on ובלי המפתחות שום פורט חדש לא נפתח.
# אחרי המילוי: docker compose --profile live-voice up -d --build
# האות עובר דרך 3210 שכבר פתוח. לקול עצמו צריך בחומת האש רק UDP 50000-50019 ו-TCP 7881. לא לפתוח 7880.
# LIVEKIT_NODE_IP היא הכתובת הציבורית של השרת (ב-Contabo: 37.60.240.231), בלי פורט.
# המפתחות: openssl rand -hex 8 ו-openssl rand -hex 24. לא להשאיר רווחים או מרכאות.
LIVE_VOICE=off
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=
# תמלול עברי. Groq Whisper זול (בערך $0.04 לשעת שמע). אם VOICE_BASE_URL כבר מצביע ל-Groq, אפשר להשאיר את GROQ_API_KEY ריק.
GROQ_API_KEY=
LIVE_VOICE_STT_MODEL=whisper-large-v3-turbo
# אם לא שומע אותך בטלפון: deepgram/nova-3 או assemblyai/universal-streaming-multilingual (רץ על מפתחות LiveKit, בלי מפתח נוסף, streaming)
# קול חינמי כשאין ElevenLabs. he-IL-HilaNeural או he-IL-AvriNeural.
EDGE_TTS_VOICE=he-IL-HilaNeural
# מספר טלפון ל-HELPER (LiveKit Cloud). ריק = השרת שלך, כמו קודם.
# כתובת הפרויקט ב-LiveKit Cloud, והמפתחות למעלה מאותו פרויקט (Settings > API keys).
# LIVEKIT_URL=wss://<project>.livekit.cloud
# השם שחוק הניתוב של המספר שולח אליו שיחות. ריק = הסוכן נכנס לכל חדר חדש.
LIVE_VOICE_AGENT_NAME=
# רק מספר הוואטסאפ שלך מדבר עם HELPER בטלפון. מספרים נוספים כאן, מופרדים בפסיק. כל מספר אחר מנותק מיד.
LIVE_VOICE_PHONE_ALLOW=
# pipeline = כמו היום (תמלול, HELPER חושב, הקראה). realtime = מודל קול מהיר מדבר בתור HELPER, ושואל את HELPER על כל דבר אמיתי.
# realtime מחובר דרך אותו מפתח של LiveKit Cloud, בלי מפתח נוסף. חיוב שימוש הולך לחשבון LiveKit.
LIVE_VOICE_MODE=pipeline
# LIVE_VOICE_REALTIME_MODEL=openai/gpt-realtime-2.1-mini
# LIVE_VOICE_REALTIME_VOICE=
# אחרי כמה שניות בלי תשובה HELPER אומר "רגע" כדי שהקו לא ישתוק. 0 = אף פעם.
LIVE_VOICE_FILLER_AFTER=1.2

# ---- יצירת תמונות (לא חובה) ----
# תמונות וסרטונים דרך ElevenLabs דורשים שם חבילת Pro ומעלה. לחלופין: שם של מודל תמונות אצל ספק הצ'אט (נקודת הקצה /images/generations).
IMAGE_MODEL=

# ---- חשבונות לקריאה בלבד ----
# מחשבונות Google האלה העוזר רק קורא: הוא לא שולח מהם מייל ולא מוסיף בהם אירועים או משימות. מופרדים בפסיק.
GOOGLE_READONLY_ACCOUNTS=

# ---- מודלים נוספים אצל אותו ספק (לא חובה) ----
# זול: לעבודת רקע תכופה (סינון מיילים, בדיקת מעקבים, סיכומים). ריק = המודל הראשי.
LLM_CHEAP_MODEL=
# חזק: לרגעים חשובים, מפעילים בצ'אט עם /model strong וחוזרים עם /model default.
LLM_STRONG_MODEL=
# גיבוי: מנסים אותו אם המודל הראשי נופל.
LLM_FALLBACK_MODEL=

# ---- אזור זמן ----
# כל התזכורות, השעות והתאריכים לפי האזור הזה, גם אם שעון המחשב מוגדר אחרת.
TIMEZONE=Asia/Jerusalem

# ---- מצב קל ----
# לספקים עם מכסת טוקנים קטנה לדקה (חבילות חינמיות). משתמש ב-persona.short.md, מקצר את השיחה ואת תוצאות הכלים.
LLM_LIGHT=false

# ---- סיכום שבועי ללימודים ----
# שבת בשעה הזאת (HH:MM) נשלח מה מחכה בשבוע הקרוב: מבחנים, הגשות ויומן. ריק = 20:00, off = כבוי.
WEEKLY_REVIEW_TIME=

# ---- תקציר חדשות בוקר ----
# שעה (HH:MM) שבה נשלח תקציר של מה שקרה מאז אתמול בערב. ריק = כבוי. צריכה להיות מחוץ לשעות השקט.
NEWS_BRIEF_TIME=08:00
# off = החדשות בהודעה נפרדת גם כשהשעה קרובה לבריף הבוקר (ברירת המחדל: הודעה אחת).
NEWS_WITH_BRIEF=
# מקורות (RSS) בעברית, מופרדים בפסיק. ריק = ynet, מעריב וישראל היום.
NEWS_FEEDS=

# --- Quiet monitoring (מעקב שקט) ---
# כל ברירת מחדל עובדת גם בלי לגעת בכלום.
WATCH_STATE_PATH=./data/watch-state.json
WATCH_MAX_TOOL_ROUNDS=4
WATCH_MAX_TOKENS=2000
WATCH_CHECK_TIMEOUT_MS=30000
WATCH_SEEN_IDS_CAP=500
# מודל זול לבדיקת טריגר, ומודל חזק להחלטת הדחיפות בלבד. placeholder או ריק = המודלים של העוזר.
WATCH_MODEL_FILTER=<cheap-model-id>
WATCH_MODEL_URGENCY=<strong-model-id>
# פריט שנצבר ויש לו מועד אחרון קרוב מזה (בשעות) נשלח מיד
URGENT_DEADLINE_HOURS=12
# לשלוח בריף בוקר גם כשאין בו כלום
DAILY_BRIEF_ALWAYS=false
# הגברה או השתקה: <שם>=interrupt-all|batch-all|drop-all, אפשר @YYYY-MM-DD לתאריך סיום, כמה ערכים מופרדים בפסיק
# WATCH_OVERRIDE_SOURCE=mail/<account>=interrupt-all@2026-12-01
# WATCH_OVERRIDE_TOPIC=<topic>=interrupt-all
WATCH_OVERRIDE_SOURCE=
WATCH_OVERRIDE_TOPIC=

# קיימים, ומשפיעים על המעקב השקט:
# QUIET_HOURS=22:00-08:00   בחלון הזה נשלח רק מה שהוחלט עליו interrupt
# DAILY_BRIEF_TIME          אם הוא בתוך שעות השקט, הבריף יוצא בסופן: max(DAILY_BRIEF_TIME, סוף QUIET_HOURS)
# MAIL_POLL_MINUTES=10      מרווח הסקר של תיבות IMAP כשהחיבור החי נפל
# TIMEZONE=Asia/Jerusalem   כל חישוב זמן

# ---- יוזמה עצמית ----
# כמה פעמים ביום העוזר פונה אליך בעצמו, בלי שהתחלת שיחה (0 = אף פעם), ומה המרווח המינימלי בדקות.
# לא בשעות השקט. אם אין לו משהו אמיתי לומר, הוא מדלג. כשיש דברים פתוחים, הוא מציע לסגור אחד מהם.
CHECK_IN_PER_DAY=2
CHECK_IN_EVERY_MINUTES=180
# כמה פעמים ביום הוא חוזר לדבר שהשארת פתוח ("אטפל בזה אחר כך", "מחכה לתשובה") כשהגיע הזמן (0 = אף פעם).
# בכל מקרה: לא בשעות השקט, לא באמצע שיחה, שעה לפחות בין הודעות יזומות, ואחרי 2 הודעות בלי תשובה ממך הוא מחכה שתכתוב.
FOLLOW_UPS_PER_DAY=3
# true = הודעות יזומות (חדשות, מטלות, צ'ק-אין) נחלשות אם מתעלמים מהן. false (ברירת המחדל) = נשלחות כמו קודם.
# "תפסיק לשלוח לי חדשות" עובד גם כשזה כבוי. חזרה לדברים פתוחים (FOLLOW_UPS) לא משתנה.
NOTICE_LEARNING=false

# ---- האזנה חיה למייל של Google ----
# true = מייל חדש מדווח ברגע שהוא נכנס (חיבור IMAP חי, לקריאה בלבד). false = בדיקה כל שתי דקות.
LIVE_MAIL=true

# ---- ספק גיבוי (לא חובה) ----
# נכנס לפעולה רק כשהמכסה של כל המודלים של הספק הראשי נגמרת. כל ספק תואם OpenAI.
# Gemini (מפתח חינמי מ-aistudio.google.com): https://generativelanguage.googleapis.com/v1beta/openai
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=

# ---- המחשב של העוזר (מכונת לינוקס ב-VirtualBox) ----
# פעיל כשקיים מפתח ב-data/vm/id_ed25519. העוזר מריץ שם פקודות בלי אישור; אין לה גישה לקבצים שלך.
VM_NAME=helper-box
VM_SSH_PORT=2222
VM_USER=helper

# ---- הדלקת המחשב מרחוק (Wake-on-LAN) ----
# כתובת הכרטיס של המחשב (MAC). עם /wake בוואטסאפ או "תדליק את המחשב" העוזר שולח חבילת הדלקה.
WAKE_MAC=
# כתובת השידור של הרשת הביתית, בדרך כלל x.x.x.255
WAKE_BROADCAST=
# רק כשהעוזר רץ מחוץ לבית (ענן): נושא וסוד שמזווגים אותו עם home-relay/wake-relay.mjs שרץ על מכשיר שתמיד דלוק בבית
WAKE_RELAY_TOPIC=
WAKE_SECRET=

# ---- כלים שתמיד מחכים ל"כן" שלך ----
# כלים ברשימה לא רצים לפני שאישרת בצ'אט, גם אם אף אחד לא ביקש אישור בתוך הכלי עצמו. מופרדים בפסיק. ריק = אין.
CONFIRM_ALWAYS=pc_type,pc_press_key,pc_unlock,pc_clipboard_get,pc_clipboard_set

# Remote panel (deploy/panel/README.md). Off until PANEL_ENABLED=on. Its own port, loopback by default; put HTTPS
# (Caddy) in front of it. Credentials are issued and revoked in the settings site, never here.
# PANEL_ENABLED=on
# PANEL_PORT=3214
# PANEL_LISTEN=127.0.0.1
# PANEL_PUBLIC_ORIGIN=https://panel.example.com
# PANEL_TRUST_PROXY=1

# WhatsApp spoken wording/preparation, OFF until an approved listening check.
# Same existing voice/model. No extra model call. Roll back with off.
WHATSAPP_SPOKEN_REPLIES=off
