<?xml version="1.0" encoding="utf-8"?>
<!-- Keys, plus window changes so HELPER knows which app is open (tv_status). The link to the HELPER server
     also lives in this service, since Android keeps an accessibility service running. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:canPerformGestures="false"
    android:notificationTimeout="300"
    android:description="@string/input_key_service_description" />
