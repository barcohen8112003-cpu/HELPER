<?xml version="1.0" encoding="utf-8"?>
<!-- NOW design top icons: no fill at rest; focused, a soft white disc behind the (scaled) icon. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#2EFFFFFF" /></shape>
    </item>
    <item><shape android:shape="oval"><solid android:color="#00000000" /></shape></item>
</selector>
