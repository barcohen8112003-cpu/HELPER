node_modules/
# Server state only (data/state.json, browser profiles). A bare "data/" would also hide
# android/app/src/main/java/com/example/helper/data/.
/data/
.env
# Generated by scripts/write-build-info.mjs when run on the host. The image builds its own copy.
/build-info.json
.tailscale.env
.env.before-openrouter
home-relay/config.json
home-relay/pc-bridge.config.json
.auto-update-bad-commit
# accept:real reports: evidence from test runs stays on the machine that ran them.
/accept-reports/

# TV launcher build output
tv/launcher/.gradle/
tv/launcher/build/
tv/launcher/app/build/
tv/launcher/local.properties
tv/screens/
# Video wallpapers stay on the TV and in this folder only (large, and not ours to publish).
tv/theme-now/*.mp4

# HELPER for Windows: downloaded speech engine and model
desktop/vendor/
desktop/node_modules/
desktop/out/
